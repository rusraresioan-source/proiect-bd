    users ||--o{ categories : "personalizeaza (0,n)"
    users ||--o{ payment_methods : "inregistreaza (0,n)"
    users ||--o{ recurring_rules : "stabileste (0,n)"
    currencies ||--o{ accounts : "denomineaza (1,n)"
    categories ||--o{ subcategories : "grupeaza (1,n)"
    accounts ||--o{ planned_payments : "asigura_fonduri (0,n)"
    subcategories ||--o{ planned_payments : "incadreaza (1,n)"
    recurring_rules ||--o{ planned_payments : "propaga (0,n)"
    accounts ||--o{ transactions : "debiteaza_sursa (0,n)"
    accounts ||--o{ transactions : "crediteaza_destinatie (0,n)"
    subcategories ||--o{ transactions : "clasifica (0,n)"
